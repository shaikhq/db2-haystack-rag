# watsonx.ai
WATSONX_API_KEY=your_watsonx_api_key
WATSONX_PROJECT_ID=your_watsonx_project_id
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Db2 (12.1.2+, native VECTOR support required)
DB2_DATABASE=BLUDB
DB2_HOSTNAME=your-db2-host
DB2_PORT=50001
DB2_UID=db2user
DB2_PWD=your_password
DB2_SECURITY=SSL

# Models
WATSONX_EMBEDDING_MODEL=ibm/slate-125m-english-rtrvr
WATSONX_CHAT_MODEL=ibm/granite-3-2b-instruct
